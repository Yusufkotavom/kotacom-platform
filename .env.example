###############################################
# Kotacom on Payload — environment template
# Copy to `.env` (local dev) or `.env.local` (git-ignored).
# NEVER commit real secrets. Rotate any value leaked to git.
###############################################

# ── Core ─────────────────────────────────────
# MongoDB connection string. For self-hosted Docker use the service name,
# e.g. mongodb://payload:***@payload-mongo:27017/payload-website?authSource=payload-website
DATABASE_URI=mongodb://127.0.0.1:27017/payload-website
# Long random string used to sign sessions & tokens. Generate: openssl rand -hex 32
PAYLOAD_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# ── Public site ──────────────────────────────
# Canonical public URL of the site (no trailing slash). Production: https://payload.kotacom.id
NEXT_PUBLIC_SITE_URL=https://payload.kotacom.id
# Set to any non-empty value to allow crawlers / remove noindex. Leave empty for staging.
NEXT_PUBLIC_IS_LIVE=true

# ── Draft preview & on-demand revalidation ───
# Both MUST be long random strings and MUST match between Next.js and Payload.
# Missing values silently disable live preview and on-demand ISR revalidation.
# Generate each: openssl rand -hex 32
NEXT_PRIVATE_DRAFT_SECRET=REPLACE_ME_DRAFT_SECRET
NEXT_PRIVATE_REVALIDATION_KEY=REPLACE_ME_REVALIDATION_KEY

# ── Analytics (optional) ─────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# ── Forms anti-spam (optional but recommended) ─
# Renders the reCAPTCHA widget ONLY when the site key is set (empty key = no widget, no crash).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PRIVATE_RECAPTCHA_SECRET_KEY=

# ── Misc (optional) ──────────────────────────
GITHUB_ACCESS_TOKEN=
NEXT_PUBLIC_ALGOLIA_DOCSEARCH_KEY=
